{
	"name": "@sigrun/ext-mcp",
	"version": "0.2.0",
	"description": "MCP extension for sigrun (pi-durable): registers MCP server tools as <server>/<toolname> tools",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"sigrun-ext-mcp": "dist/bin.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node scripts/check-manifest.mjs --expect-name @sigrun/ext-mcp && vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"@sigrun/sigrun": "file:../sigrun",
		"@types/node": "^26.6.4",
		"tsx": "^4.23.15",
		"typebox": "1.3.27",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun-ext-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun-ext-mcp/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun-ext-mcp#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
